# Copy to .env and fill in your own keys. Never commit .env.
SONIOX_API_KEY=
OPENAI_API_KEY=

SONIOX_MODEL=stt-rt-v5
# UI의 최초 기본값. 실시간·최종·과목 종합 노트에서 GPT-6.1 Sol / Luna를 선택할 수 있습니다.
OPENAI_REALTIME_MODEL=gpt-6-luna
OPENAI_FINAL_MODEL=gpt-6.1-sol

# Local MVP limits. Restart the server after changing settings.
MAX_SESSION_SECONDS=7200
# uvicorn과 ngrok을 따로 실행하면 여기에 본인의 ngrok 호스트명도 쉼표로 추가합니다.
# 예: localhost,127.0.0.1,[::1],example.ngrok-free.dev
ALLOWED_HOSTS=localhost,127.0.0.1,[::1]

# 휴대폰 접속: python run_mobile.py (ngrok 설치 필요)
# ngrok config add-authtoken으로 이미 등록했다면 비워 둬도 됩니다.
NGROK_AUTHTOKEN=
# 계정에 지정된 HTTPS 주소가 있을 때만 입력합니다.
NGROK_URL=
# 비우면 실행마다 임의의 접속 비밀번호를 생성해 터미널에 표시합니다. 아이디는 voice입니다.
MOBILE_PASSWORD=
# PATH에서 ngrok을 찾을 수 없을 때만 실행 파일의 절대 경로를 입력합니다.
NGROK_BIN=
